<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PedidosMostrar">

    <Button
        android:id="@+id/btnPedidosMostrarVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:text="Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnPedidosMostrarAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="104dp"
        android:layout_marginTop="20dp"
        android:text="Agregar Producto"
        app:layout_constraintStart_toEndOf="@+id/btnPedidosMostrarVolver"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txvInfoPedido"
        android:layout_width="379dp"
        android:layout_height="236dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="Pedido:"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnPedidosMostrarVolver" />

    <fragment
        android:id="@+id/fragPedidosMostrarLista"
        android:name="com.example.rutapedidos.Fragments.ListaFragment"
        android:layout_width="410dp"
        android:layout_height="420dp"
        android:layout_marginTop="310dp"
        android:layout_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>