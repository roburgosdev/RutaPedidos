<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Clientes">

    <Button
        android:id="@+id/btnClientesVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:text="Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnClientesSincronizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="176dp"
        android:layout_marginTop="16dp"
        android:text="Sincronizar"
        app:layout_constraintStart_toEndOf="@+id/btnClientesVolver"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="44dp"
        android:text="Clientes"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@+id/btnClientesSincronizar"
        app:layout_constraintStart_toEndOf="@+id/btnClientesVolver"
        app:layout_constraintTop_toTopOf="parent" />

    <fragment
        android:id="@+id/fragClientesLista"
        android:name="com.example.rutapedidos.Fragments.ListaFragment"
        android:layout_width="410dp"
        android:layout_height="630dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="100dp"
        android:layout_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>