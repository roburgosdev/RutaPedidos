<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/icono_pedido" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCabecera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Pedido #12 · Almacén Central" />

        <TextView
            android:id="@+id/tvRut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="RUT: 76.123.456-7" />

        <TextView
            android:id="@+id/tvCreador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="Creado por: vendedor@ejemplo.cl" />

        <TextView
            android:id="@+id/tvEmision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="Fecha de emisión: 24/10/2026" />

        <TextView
            android:id="@+id/tvEntrega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="Fecha de entrega: 26/10/2026" />

        <TextView
            android:id="@+id/tvOrdenCompra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="Orden de compra: OC-123" />

        <TextView
            android:id="@+id/tvNeto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="Neto: $10000" />

        <TextView
            android:id="@+id/tvDescuento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="Descuento: $1000" />

        <TextView
            android:id="@+id/tvImpuesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="Impuesto: $1710" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="Total: $10710" />



        <TextView
            android:id="@+id/tvSincronizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            tools:text="Sincronización: Pendiente de sincronizar" />
    </LinearLayout>
</LinearLayout>
